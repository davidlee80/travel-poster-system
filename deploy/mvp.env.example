# 单机内测部署的环境变量样例（Ubuntu 云主机）
#
# 与仓库根的 `env.example` 的区别：那份是**本地开发**用的（服务跑在宿主、
# 用 localhost 互连、口令是明文占位）。这份是**容器内互连**用的：
# 主机名是 compose 服务名，且列出的都是必须按机器改的项。
#
# 用法（在仓库根）：
#   cp deploy/mvp.env.example .env.deploy
#   $EDITOR .env.deploy
#
# `.env.deploy` 不入库（见仓库根 .gitignore 的 .env* 规则）。
#
# ## 这里没有列出的东西
#
# 配额（QUOTA_*）、保留期（ANON_RETENTION_*）、超时（*_TIMEOUT_MS）全部在
# 代码里有与 env.example 一致的默认值，不必重复一遍 —— 重复的配置项会与
# 默认值漂移，而漂移的方向通常是「文档比代码旧」。要改哪一项再加哪一项。
#
# 每个服务各自不同的三项（S3_ENDPOINT、INTERNAL_API_BASE、RENDER_BASE_URL）
# 写在 `deploy/mvp-apps.yml` 的 environment 里，不在这里 —— 它们是拓扑而不是配置。

NODE_ENV=production
LOG_LEVEL=info
TZ=UTC

# ── 数据库与 Redis（主机名 = compose 服务名）────────────────
#
# 口令沿用 infrastructure/docker-compose.yml 里硬编码的 tps_local_dev_only。
# 这是内测取舍：那两个端口只在安全组内可达，攻击面是「已经登上这台机器的人」。
# 正式上线要换成托管数据库 + 独立凭据，改这两行即可。
DATABASE_URL=postgres://tps:tps_local_dev_only@postgres:5432/travel_poster
REDIS_URL=redis://redis:6379

# ── 对象存储 ──────────────────────────────────────────────
#
# **S3_ENDPOINT 必须是浏览器能访问到的地址。**
#
# 13.6 的导出下载是 api 侧算出的 SigV4 预签名 URL，主机名就取自这个变量
# （`loadExportsStorageConfig` 没有「对外基地址」的覆盖项）。填 http://minio:9000
# 的表现是：导出任务全部成功、库里记录完整、而用户点下载打不开。
#
# SigV4 把 Host 头也签进签名，因此反代必须原样透传 Host（见部署说明的 Nginx 段），
# 也因此**不能**用路径前缀（https://域名/s3）代替子域名 —— 签名里的路径会对不上。
#
# 下面填的是本项目实际部署的地址（doomet.cn）。换机器/换域名时改这两处，
# 对应的 Nginx server_name 与证书见 docs/云服务器部署说明.md 的 1.3.1 与第 8 节。
S3_ENDPOINT=https://travel.doomet.cn
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tps
S3_SECRET_ACCESS_KEY=tps_local_dev_only
S3_BUCKET_ASSETS=tps-assets
S3_BUCKET_EXPORTS=tps-exports
S3_FORCE_PATH_STYLE=true

# 素材的对外基地址。它会被写进 plan_presentations.view_model 并**永久保存**
# （19.3），因此第一天就要填最终地址 —— 事后改域名不会修正已存的那些。
#
# ## 「事后改不了」比字面上更严格：素材记录也缓存了这个前缀
#
# 改了这一行并重启，**新生成的计划里仍然是旧地址** —— 19.2 的素材缓存命中时
# 直接复用 `assets` 表里已存的 URL，那是首次入库时按当时的前缀拼好的。
# 实测过：改完重启后连续五次生成，view_model 里全是旧地址。
# 真要换地址，除了改这一行还得清素材缓存（或批量改库），否则改动完全无效
# 而现象是「配置明明改了却没生效」。
#
# ## 这个地址有两个网络视角不同的消费者，必须同时满足
#
#   1. 用户的浏览器          —— 从公网访问
#   2. render-worker 容器内的 Chromium —— 导出时要真的下载这些图
#
# 填 https://travel.doomet.cn 能同时满足两者（代价是渲染时每张图都绕一圈
# 公网 + Nginx + TLS 回到本机，Nginx 或 DNS 故障会连带影响导出）。
# 填只有一侧能解析的地址（例如 http://localhost:9000 或 http://minio:9000）
# 则必有一侧取不到图。
#
# 取不到图的表现**不是报错**：RenderReadyProbe 刻意让坏图不阻塞就绪
# （十八章降级链），因此导出照样 COMPLETED、健康检查全绿，而用户拿到的长图里
# 每个图片位置都是空白。现在这种情况会记 error 日志并计入
# travel_render_asset_image_failure_total —— 部署后先看这个指标是不是 0。
S3_PUBLIC_BASE_URL=https://travel.doomet.cn/tps-assets

# ── 密钥（必须逐台生成）──────────────────────────────────
#
#   openssl rand -hex 32
#
# RENDER_SIGNING_KEY：17.1 内部渲染路由的 HMAC 密钥。render-worker 用它签发、
#   web 的中间件用它校验 —— **两个服务必须是同一个值**，不一致的表现是导出
#   永远停在 RENDERING（渲染页一律 404）。
# INTERNAL_API_KEY：14.1/14.2 内部端点的共享密钥。留空则 api 不注册那些路由，
#   而 web 取展示数据要用它 —— 留空的表现是渲染页拿不到数据。
#   注意不能加 NEXT_PUBLIC_ 前缀，否则会被打进浏览器包。
RENDER_SIGNING_KEY=
INTERNAL_API_KEY=

# ── HTTPS 与 Cookie ──────────────────────────────────────
#
# 缺省 = NODE_ENV==='production' → true，即只在 HTTPS 下下发 Cookie。
# **还没配 TLS、用 http://IP 先验一遍时必须显式设为 false**，
# 否则浏览器静默丢弃会话 Cookie —— 表现是「注册成功但立刻又是未登录」。
# 配好证书后删掉这一行。
# COOKIE_SECURE=false

# ── 模型与图源（先 fake 打通链路，再接真凭据）──────────────
#
# fake 三件套跑得通整条链路，但产出的是固定的杭州 POI + 渐变占位图。
# 接真凭据的顺序建议：LLM_MODE 先（内容立刻真实）→ IMAGE_* 后（成本更高）。
# direct/gateway 缺任一项凭据时**启动即失败**，不会静默回退到 fake。
LLM_MODE=fake
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

IMAGE_MODE=fake
IMAGE_MODEL=
IMAGE_BASE_URL=
IMAGE_API_KEY=

# 超时分层（21.2 措施二，V1.8）。三项都有代码默认值，写出来是为了让「T2 目标
# 155 秒是怎么来的」在这里就能读出：75(T1) + 40 × 2 候选 = 155。
#
# IMAGE_TIMEOUT_MS > IMAGE_JOB_AI_BUDGET_MS 会**拒绝启动**（单候选就能耗尽预算，
# 故障转移不会生效）；预算超过 80000 只 warn，但必须同步调 T2 告警阈值。
IMAGE_TIMEOUT_MS=40000
IMAGE_PREHEAT_TIMEOUT_MS=60000
IMAGE_JOB_AI_BUDGET_MS=80000

# 候选模型池不在这里配，在 model_pools / tier_model_pools 两张表里（迁移 0009）。
# 两张表为空 ⇒ 回落到上面的单模型行为，与接入前完全一致。用两个 CLI 管理：
#   pnpm model:pool -- --list
#   pnpm user:tier  -- --email a@b.com --set 10
# 改完最多 60 秒生效，不需要重启。排查见运维手册「主模型胜出率下降」。

# 本轮仓库未接入任何授权图源适配器，direct 会启动即失败（P6 交付边界）。
IMAGE_SEARCH_MODE=fake

# ── 灰度开关 ──────────────────────────────────────────────
FEATURE_GENERATION_ENABLED=true
FEATURE_EXPORT_ENABLED=true
FEATURE_GENERATION_ROLLOUT_PERCENT=100
# P7：前端来的一切请求都必须是注册用户。默认就是 false，写出来是为了让
# 「这台机器上匿名是关的」在配置里一眼可见。
FEATURE_ANONYMOUS_ENABLED=false

# ── 可观测性（留空 = 不装配 OTel SDK，零开销）──────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=travel-poster-system

# 必须小于 compose 的 stop_grace_period（见 mvp-apps.yml）
SHUTDOWN_TIMEOUT_MS=25000

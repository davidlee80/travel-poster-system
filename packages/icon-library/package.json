{
  "name": "@tps/icon-library",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "typecheck": "pnpm generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "pnpm generate && vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo src/generated *.tsbuildinfo"
  },
  "dependencies": {
    "@tps/schemas": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@tps/presentation": "workspace:*"
  }
}

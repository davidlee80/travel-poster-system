# 本地开发环境变量样例。复制为 .env 后按需修改（.env 不入库）。
#
#   cp env.example .env
#
# 生产环境由编排层注入，不使用 .env 文件。
# 秘密只在进程内使用，不进日志、指标、错误消息（设计稿二十章）。

NODE_ENV=development
LOG_LEVEL=debug
TZ=UTC

# ── 数据库 ────────────────────────────────────────────────
DATABASE_URL=postgres://tps:tps_local_dev_only@localhost:5432/travel_poster
DATABASE_POOL_MAX=10

# 检索路径专用的受限只读角色（设计稿 15.2）。
# 该角色只被授予 travel_plan_versions 的部分列，SELECT plan_json 会被数据库拒绝。
# P2（TP-2-22）启用，P0/P1 留空。
# DATABASE_RETRIEVAL_URL=postgres://travel_retrieval_ro@localhost:5432/travel_poster

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── 大模型访问（设计稿 1.3、6.3）─────────────────────────
# fake    回放按请求构造的示例数据。**默认**，本地与 CI 用它，不需要凭据。
#         产出的行程内容是固定的几个杭州 POI，只用于打通链路，不是可用行程。
# direct  走 ofox（https://api.ofox.ai）的 OpenAI 兼容端点 —— 一个 key 覆盖 100+ 模型
# gateway 经企业 AI 网关（同为 OpenAI 兼容），由网关统一鉴权、限流与成本归集
LLM_MODE=fake
# direct / gateway 模式下三项必填，缺任一项启动即失败（不会回退到 fake）
#
# 模型 ID **必须带 provider 前缀**：openai/gpt-5.5，不是 gpt-5.5。
# 清单见 https://ofox.ai/models。少数模型只支持 responses API
# （openai/gpt-5.4-pro 一类），本系统走 chat/completions，配了会失败。
LLM_MODEL=
# **不带 /v1 尾缀** —— 填 https://api.ofox.ai
#
# ofox 文档写的是 baseURL: https://api.ofox.ai/v1，那是给 SDK 用户的：
# 各家 SDK 自己拼后半段路径。本系统不用 SDK，自己拼 /v1/chat/completions，
# 所以带上 /v1 会打到 /v1/v1/... 。照抄文档是最容易犯的一个错，因此
# loadLlmConfig 会启动即拒 —— 否则症状是一串归因不明的 HTTP 404 重试。
LLM_BASE_URL=
# 同样不带 /v1（拼路径的是客户端，与走哪个端点无关）
LLM_GATEWAY_URL=
# ofox 的 key 形如 sk-of-…
LLM_API_KEY=
# 3.2.2：单次调用超时 30 秒
LLM_TIMEOUT_MS=30000
#
# 首次换真实 key 时先跑探针，别直接起服务。生产代码为了不回显提示词（二十章）
# 只保留状态码，联调时四种失败原因在日志里长得一模一样；探针隔离变量逐项探，
# 并回显完整错误体。
#
# **不要用 --api-key 传 key**：命令行参数会进 shell history，也会出现在同机
# 其他用户的 ps 输出里。两个探针都用 `node --env-file-if-exists=.env` 启动，
# 直接读本文件复制出来的 .env —— 填好就跑，key 不经过命令行：
#   pnpm probe:llm     # 读 LLM_MODEL / LLM_BASE_URL / LLM_API_KEY
#   pnpm probe:image   # 读 IMAGE_*，缺省回落 LLM_*
# 无凭据时加 --dry-run 只跑本地体检（schema 是否满足 strict、size 枚举是否合规）。
# 凭据放在别处（如 .env.deploy）时用 `set -a; source 那个文件; set +a` 再跑，
# 同样不留 history。

# ── 图片模型访问（P4，设计稿 11.1、21.2 措施二）───────────
# fake    由调用方注入渲染函数（generation-worker 用 sharp 画渐变图）。
#         **默认**，本地与 CI 用它。产物是渐变占位而不是插画，只用于打通链路。
# direct  走 ofox 的 OpenAI 兼容 images 端点（/v1/images/generations）
# gateway 经企业 AI 网关（同为 OpenAI 兼容）
#
# 与 LLM_* 分开是有意的：文本与图片在多数供应商上是不同的端点，甚至不同供应商。
# 走 ofox 时两者地址与 key 可以相同，但仍要各填一遍 —— 共用一套变量的表现是
# 「换文本供应商之后图片请求全部 404」，而排查方向会先落在图片模型名上。
IMAGE_MODE=fake
# 同样要带 provider 前缀，且必须是 Endpoints 含 images 的模型：
# openai/gpt-image-2、google/gemini-3-pro-image 等（见 ofox 的 MODELS 清单）。
#
# Gemini 系图片模型（google/*-image-*）走 OpenAI images 端点时只接受最少参数。
# 本系统已不发 n（见 image.ts），但仍会发 response_format=b64_json ——
# 二十章要求图片必须转存自有存储、不能引用第三方 URL，那一项不能省。
# 若某个 Gemini 模型因此被拒，换 openai/* 图片模型，或走 Gemini 原生协议（V1 不支持）。
IMAGE_MODEL=
# 同 LLM_BASE_URL：**不带 /v1 尾缀**，填 https://api.ofox.ai
IMAGE_BASE_URL=
IMAGE_GATEWAY_URL=
IMAGE_API_KEY=
# ── 超时分层（21.2 措施二，V1.8）──────────────────────────
# 三个时间参数各管一件事，不要互相顶替。
#
# 主路径的单候选超时。V1.1 曾把它压到 20 秒并**硬拒**更大的值；V1.8 引入多模型
# 候选池后 T2 目标本身成了可以有意调整的量（110 → 155 秒），硬拒会挡住合法调整。
# 现在的上限判据是「与任务级预算的关系」：见 IMAGE_JOB_AI_BUDGET_MS。
IMAGE_TIMEOUT_MS=40000
# 预热路径（pnpm assets:preheat）的单候选超时。它**不在 T2 的窗口内** ——
# 预热过的目的地本来就不需要主路径再生图，所以这里可以慢慢生。
# 与主路径共用一个值的代价是：较严的那条会决定另一条，要么主路径违约 T2，
# 要么预热被压到跟主路径一样紧而白白降低成图率。
IMAGE_PREHEAT_TIMEOUT_MS=60000
# 任务级 AI 累计耗时预算（时延的唯一防线）。
#
# 21.4 的「单任务 3 张」与 21.2 的「Hero 最多 2 次」都是**用次数近似时延**，
# 而那个近似的前提是「一次生成最多 20 秒」这个硬编码常量。超时可配 + 候选链
# 之后，同样的「2 次」可以是 80 秒也可以是 400 秒 —— 次数只剩成本含义。
#
# 两条校验：
#   IMAGE_TIMEOUT_MS > 本项            → **拒绝启动**（单候选就能耗尽预算，
#                                        候选链轮不到第二个，故障转移不会生效）
#   本项 > 80000（= T2 155s − T1 75s） → 允许，但启动日志打
#                                        IMAGE_SLA_BUDGET_EXCEEDED，
#                                        且必须同步调 T2 目标与告警阈值
IMAGE_JOB_AI_BUDGET_MS=80000
# 21.4 全局熔断：AI 图片日调用量阈值，达到后全局切到「素材库 + 占位图」。
# 默认 600 = 19.5 的预热规模（Top 50 目的地 × 12 主题桶）——
# 一天烧掉相当于整个预热库的量，说明缓存命中率出了问题，此时降级比继续付费好。
#
# **V1.8 起口径是「实际发出的请求数」而不是「成功的张数」**：超时的候选，
# 供应商很可能已经生成完并计了费，我们只是没等到。这会让 600 比以前更早触发，
# 那是预期的（它现在才真实反映成本）—— 过早就调这个数，不要改回口径。
AI_IMAGE_DAILY_BUDGET=600

# ── 多模型候选池（V1.8，迁移 0009）────────────────────────
# 候选模型**不在 env 里配**，而在 model_pools / tier_model_pools 两张表里 ——
# 运营要能在不重启的前提下改。两张表为空时系统回落到上面的 IMAGE_MODEL /
# LLM_MODEL 单模型行为，也就是迁移后不配置任何池，行为与 V1.1 完全一致。
#
#   pnpm model:pool -- --list                                   看当前配置与实际候选数
#   pnpm model:pool -- --set-pool paid --kind IMAGE --models a,b 写池（顺序即尝试顺序）
#   pnpm model:pool -- --map --kind IMAGE --min-tier 10 --pool paid --max-candidates 2
#   pnpm user:tier  -- --email a@b.com --set 10                 给用户设分层等级
#
# 改完 Worker 侧最多 60 秒生效（进程内缓存 TTL）。排查见运维手册的
# 「主模型胜出率下降」与「候选池配置被截断」两节。

# ── 授权图源联网搜索（设计稿 9.6，R-45/R-46）──────────────
# 降级链的第 1 级前半：缓存键 → 素材库 → **搜索** → AI 生成 → 占位图。
# 搜索命中后必须走完自动入库流水线才能使用（不允许用完即弃），
# 因此一次命中是全平台共享资产 —— 匿名与注册同额。
#
# fake    可编排的假图源。**默认**，本地与 CI 用它。整条入库流水线、
#         配额、熔断都走真实代码路径，只有 HTTP 那一段是假的。
# direct  直连授权图源的检索 API。**本轮启动即失败** —— 仓库尚未接入
#         任何图源适配器（P6 交付边界）。接入方式见错误消息。
IMAGE_SEARCH_MODE=fake
# 图源白名单，逗号分隔。只允许已签约图库或 CC0 源（9.6：禁止抓取无授权来源，
# 版权不明的图一旦入库会被后续所有请求长期复用，污染是累积性的）。
# 不接受运行时添加 —— 没有任何 API 能往这个名单里加东西。
IMAGE_SEARCH_PROVIDERS=
# 9.6：单次搜索超时 5 秒。搜索是冷路径，不占 10.2 的 800 毫秒库内预算；
# 超时即降入 AI 层，不重试。**5000 是上限**，理由同 IMAGE_TIMEOUT_MS。
IMAGE_SEARCH_TIMEOUT_MS=5000
# 9.6 的 BUDGET_IMAGE_SEARCH_DAILY：图源 API 日调用量阈值，
# 达到后全局降级为「库内 + AI + 占位」，服务不中断。
# 默认 2000 = 种子素材库规模 —— 一天搜索入库量相当于整个种子库，
# 说明冷组合命中出了问题（主题桶归一化失效或素材库覆盖崩了）。
IMAGE_SEARCH_DAILY_BUDGET=2000

# ── 对象存储（S3 兼容）────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tps
S3_SECRET_ACCESS_KEY=tps_local_dev_only
S3_BUCKET_ASSETS=tps-assets
S3_BUCKET_EXPORTS=tps-exports
S3_FORCE_PATH_STYLE=true
# 素材的对外访问基地址（生产填 CDN 域名）。缺省为 S3_ENDPOINT/S3_BUCKET_ASSETS。
# 必须可配置：素材 URL 会写进 plan_presentations.view_model 并永久保存（19.3），
# 换 CDN 时旧 URL 仍要能访问，因此不能从 endpoint 拼死。
# S3_PUBLIC_BASE_URL=

# ── 服务端口 ──────────────────────────────────────────────
API_PORT=3001
WEB_PORT=3000

# 必须小于 K8s terminationGracePeriodSeconds（设计稿 22.3.3）
SHUTDOWN_TIMEOUT_MS=25000

# ── 身份与配额（R-13，设计稿 3.6、21.4）──────────────────
# 匿名令牌有效期（天）
ANON_TOKEN_TTL_DAYS=30
# 匿名数据保留期（天）。到期后 30 天宽限，然后清理（设计稿 15.1）
ANON_RETENTION_DAYS=30
# 到期后的宽限天数与每批清理量（15.1）。retention-worker 用。
ANON_RETENTION_GRACE_DAYS=30
RETENTION_BATCH_SIZE=500
# 扫描间隔，默认 24 小时。调短只用于集成测试与预发环境 ——
# 生产调频前先看 travel_anon_purge_total 是否真的追不上。
RETENTION_INTERVAL_MS=86400000

# 配额：匿名与注册分档，全部可配置（设计稿 21.4）。
# 匿名日配额按用户决定暂定为 5。
QUOTA_ANON_DAILY_PLANS=5
QUOTA_ANON_MONTHLY_PLANS=10
QUOTA_ANON_PER_MINUTE=1
QUOTA_ANON_EXPORTS_PER_PLAN=3
QUOTA_ANON_AI_HERO=0

QUOTA_REGISTERED_DAILY_PLANS=5
QUOTA_REGISTERED_MONTHLY_PLANS=20
QUOTA_REGISTERED_PER_MINUTE=3
QUOTA_REGISTERED_EXPORTS_PER_PLAN=10
QUOTA_REGISTERED_AI_HERO=2

# IP 维度防刷（不依赖 Cookie，清 Cookie 无效）。
# 匿名日配额提到 5 后，IP 日上限同步提到 10，否则单 IP 只够两个匿名用户用满。
QUOTA_IP_ANON_CREATE_PER_HOUR=5
QUOTA_IP_ANON_CREATE_PER_DAY=20
QUOTA_IP_PLANS_PER_DAY=10
QUOTA_IP_LOGIN_FAILURES_PER_HOUR=10
QUOTA_EMAIL_LOGIN_FAILURES_PER_HOUR=5

# ── 内部端点（P3，设计稿 14.1、14.2、17.1）────────────────
# 内部端点的共享密钥。**留空则不注册这些路由** ——
# 它们做 CPU 与数据库工作，挂在公网服务上必须有认证。
# 生产必须为高强度随机值。web 也要读它（渲染路由按版本取展示数据），
# 注意**不能**加 NEXT_PUBLIC_ 前缀，否则会被打进浏览器包。
# INTERNAL_API_KEY=
# web 服务端到 API 的地址（与浏览器用的 NEXT_PUBLIC_API_BASE 分开）
INTERNAL_API_BASE=http://localhost:3001

# ── 渲染（P1 起用）────────────────────────────────────────
# 内部渲染路由的 HMAC 签名密钥（设计稿 17.1）。生产必须为高强度随机值。
# render-worker **必填**（它要为每个页面签发令牌）。
# RENDER_SIGNING_KEY=
# render-worker 访问 web 服务的地址（渲染路由在 web 上，不在 api 上）。
# 与 INTERNAL_API_BASE 方向相反：那是 web → api，这里是 render → web。
RENDER_BASE_URL=http://localhost:3000
# /dev/shm 不足时的兜底（设计稿 22.3.2、L-07）
CHROMIUM_DISABLE_DEV_SHM=false

# ── 可观测性（TP-5-03）────────────────────────────────────
#
# 留空 = 不装配 OTel SDK，全进程保持 no-op（零开销）。本地开发与 CI 都不
# 需要 collector —— 「必须先起一个 collector 才能跑测试」会让人把可观测性
# 从开发环境里摘掉，而那正是最需要它的地方。
#
# 填的是**基地址**，`/v1/traces` 由代码拼接。
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
#
# 采样率 0～1，缺省 1（全采样）。V1 内测量小，而漏掉的恰好是要排查的
# 那一条会非常难受；放量后再调低。
# OTEL_TRACES_SAMPLER_ARG=1
#
# 写进 span 的 service.version（资源属性），便于按版本比较延迟变化。
# SERVICE_VERSION=
OTEL_SERVICE_NAME=travel-poster-system

# ── 灰度开关（TP-5-10）────────────────────────────────────
#
# 一次放量只改这三个值，不改镜像。生产上由 Helm 的 featureFlags 注入。
#
# 关闭时对应端点返回 503 SYS_FEATURE_DISABLED（retryable: true，
# 客户端据此保留用户填的表单而不是清空它）。
FEATURE_GENERATION_ENABLED=true
# 与生成分开关：两者成本量级差三个数量级。紧急降成本时先关生成、保留导出 ——
# 用户至少还能把已有的计划导出带走
FEATURE_EXPORT_ENABLED=true
# 0～100 的整数。越界拒绝启动（把 1000 误当千分比会是一次静默的全量上线）。
# 按 user_id 的稳定哈希分桶：同一个用户每次得到同一个结果，
# 且比例提高时原来命中的用户仍然命中
FEATURE_GENERATION_ROLLOUT_PERCENT=100
# ── 匿名身份入口（P7）────────────────────────────────────
#
# false（**默认**）：前端来的一切请求都必须是注册用户 ——
#   不自动创建匿名号，已有的 tp_anon 凭据一律不解析（401 AUTH_IDENTITY_REQUIRED
#   并顺便清除该 Cookie）。存量匿名数据仍照常走 30 天保留期清理 + 知识转存。
# true：恢复 R-13 的双模式旧行为（匿名可直接生成）。
#
# **默认值与上面三个开关相反，这是有意的。** 那三个是「正常开着，紧急时关」，
# 忘记配等于「和引入灰度之前一样」；而这一个是产品已经决定关闭的功能，
# 默认 true 会让任何漏配的部署静默重新开放匿名注册 —— 那是产品行为的回退，
# 不是可观测的故障：没有任何告警会响，只有转化数据在几周后变得可疑。
#
# 重新打开只需改这一个变量并重启 api：无需迁移、无需数据修复（见运维手册）。
FEATURE_ANONYMOUS_ENABLED=false

# ── 用户货币 CR（C-3）────────────────────────────────────
#
# 设计与分期见 docs/用户货币与计费.md。
#
# **默认关闭，而这不是保守而已。** 钱包与价目表在迁移 0013 才建立，而应用与
# 数据库的部署不是原子的。装配了却没迁移的后果是每个生成请求、每次会话查询
# 都撞「relation credit_wallets does not exist」—— 也就是全站不可用，
# 而根因在一张不存在的表上。
#
# 打开顺序：先 pnpm db:migrate 到 0013，再把这个置 true 并重启 api。
# 关闭时 /credits/* 三个端点不注册，生成与导出完全不计费。
CREDIT_BILLING_ENABLED=false
#
# 1 元人民币兑多少 CR。**改它等于给所有存量余额重新标价** ——
# 库里存的是 CR，比率变了含义就变了。真要改必须同时迁移余额。
CREDIT_CR_PER_CNY=1000
# 首次注册赠送（C-5 起生效）。0 = 不赠送
CREDIT_SIGNUP_GRANT_CR=9900
# 预留额相对典型估算的放大，百分比。**必须 >= 100** —— 低于 100 等于
# 故意让结算超出预留，而超出的部分要么把余额扣成负数（CHECK 拒绝、
# 事务失败、任务卡住），要么由我们承担
CREDIT_HOLD_BUFFER_PERCENT=120
#
# 估算参数。前三个必须 >= worker 侧的真实上限，由
# apps/generation-worker/src/assets/billing-limits.test.ts 守住 ——
# 估得比实际低的表现是预留恒少一笔，长期就是一笔坏账
CREDIT_EST_MAX_AI_IMAGES=3
CREDIT_EST_MAX_IMAGE_SEARCHES=8
CREDIT_EST_MAX_REGENERATIONS=2
# 输入 token 没有硬上限（提示词长度取决于约束条数与检索到的参考数量），
# 因此用「每天多少 token」的经验值乘天数
CREDIT_EST_INPUT_TOKENS_PER_DAY=3000

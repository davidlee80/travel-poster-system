# 本地开发环境变量样例。复制为 .env 后按需修改（.env 不入库）。
#
#   cp env.example .env
#
# 生产环境由编排层注入，不使用 .env 文件。
# 秘密只在进程内使用，不进日志、指标、错误消息（设计稿二十章）。

NODE_ENV=development
LOG_LEVEL=debug
TZ=UTC

# ── 数据库 ────────────────────────────────────────────────
DATABASE_URL=postgres://tps:tps_local_dev_only@localhost:5432/travel_poster
DATABASE_POOL_MAX=10

# 检索路径专用的受限只读角色（设计稿 15.2）。
# 该角色只被授予 travel_plan_versions 的部分列，SELECT plan_json 会被数据库拒绝。
# P2（TP-2-22）启用，P0/P1 留空。
# DATABASE_RETRIEVAL_URL=postgres://travel_retrieval_ro@localhost:5432/travel_poster

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── 对象存储（S3 兼容）────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tps
S3_SECRET_ACCESS_KEY=tps_local_dev_only
S3_BUCKET_ASSETS=tps-assets
S3_BUCKET_EXPORTS=tps-exports
S3_FORCE_PATH_STYLE=true

# ── 服务端口 ──────────────────────────────────────────────
API_PORT=3001
WEB_PORT=3000

# 必须小于 K8s terminationGracePeriodSeconds（设计稿 22.3.3）
SHUTDOWN_TIMEOUT_MS=25000

# ── 身份与配额（R-13，设计稿 3.6、21.4）──────────────────
# 匿名令牌有效期（天）
ANON_TOKEN_TTL_DAYS=30
# 匿名数据保留期（天）。到期后 30 天宽限，然后清理（设计稿 15.1）
ANON_RETENTION_DAYS=30

# 配额：匿名与注册分档，全部可配置（设计稿 21.4）。
# 匿名日配额按用户决定暂定为 5。
QUOTA_ANON_DAILY_PLANS=5
QUOTA_ANON_MONTHLY_PLANS=10
QUOTA_ANON_PER_MINUTE=1
QUOTA_ANON_EXPORTS_PER_PLAN=3
QUOTA_ANON_AI_HERO=0

QUOTA_REGISTERED_DAILY_PLANS=5
QUOTA_REGISTERED_MONTHLY_PLANS=20
QUOTA_REGISTERED_PER_MINUTE=3
QUOTA_REGISTERED_EXPORTS_PER_PLAN=10
QUOTA_REGISTERED_AI_HERO=2

# IP 维度防刷（不依赖 Cookie，清 Cookie 无效）。
# 匿名日配额提到 5 后，IP 日上限同步提到 10，否则单 IP 只够两个匿名用户用满。
QUOTA_IP_ANON_CREATE_PER_HOUR=5
QUOTA_IP_ANON_CREATE_PER_DAY=20
QUOTA_IP_PLANS_PER_DAY=10
QUOTA_IP_LOGIN_FAILURES_PER_HOUR=10
QUOTA_EMAIL_LOGIN_FAILURES_PER_HOUR=5

# ── 渲染（P1 起用）────────────────────────────────────────
# 内部渲染路由的 HMAC 签名密钥（设计稿 17.1）。生产必须为高强度随机值。
# RENDER_SIGNING_KEY=
# /dev/shm 不足时的兜底（设计稿 22.3.2、L-07）
CHROMIUM_DISABLE_DEV_SHM=false

# ── LLM（P2 起用）─────────────────────────────────────────
# direct = 直连 Anthropic SDK；gateway = 走 enterprise-ai-platform 网关
LLM_CLIENT=direct
# ANTHROPIC_API_KEY=
# LLM_GATEWAY_URL=
# LLM_GATEWAY_TOKEN=

# ── 可观测性（P5 装配 SDK）────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=travel-poster-system

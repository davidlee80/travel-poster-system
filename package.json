{
  "name": "travel-poster-system",
  "version": "0.0.0",
  "private": true,
  "description": "旅行计划信息图系统 —— 自动生成可浏览 HTML、每日信息图、PNG 长图与 PDF 的旅行计划平台",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rimraf node_modules",
    "db:build": "pnpm --filter \"@tps/db...\" run build",
    "db:migrate": "pnpm db:build && node packages/db/dist/cli.js migrate",
    "db:status": "pnpm db:build && node packages/db/dist/cli.js status",
    "infra:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml down",
    "infra:logs": "docker compose -f infrastructure/docker-compose.yml logs -f",
    "verify:linux-guardrails": "node tools/verify-linux-guardrails.mjs",
    "test:integration": "turbo run test:integration",
    "test:validation": "pnpm --filter @tps/planning exec vitest run plan-rules repair-plan resolve-plan",
    "fixture:render": "docker compose -f deploy/render-fixture.compose.yml run --rm --build render",
    "fixture:render:low-shm": "docker compose -f deploy/render-fixture.compose.yml --profile low-shm run --rm --build render-low-shm",
    "fixture:down": "docker compose -f deploy/render-fixture.compose.yml down -v",
    "fonts:build": "pnpm --filter @tps/fonts fonts:build",
    "fonts:scan": "pnpm --filter @tps/fonts fonts:scan -- --strict",
    "visual:check": "node tools/visual-baseline.mjs check",
    "visual:update": "node tools/visual-baseline.mjs update"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "current",
        "x64"
      ],
      "libc": [
        "current",
        "glibc"
      ]
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}

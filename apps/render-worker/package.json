{
  "name": "@tps/render-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "start": "node --enable-source-maps dist/main.js",
    "clean": "rimraf dist .turbo *.tsbuildinfo",
    "render:fixture": "node --enable-source-maps dist/cli.js"
  },
  "dependencies": {
    "@tps/observability": "workspace:*",
    "@tps/presentation": "workspace:*",
    "@tps/shared": "workspace:*",
    "pdf-lib": "^1.17.1",
    "playwright-core": "1.62.1",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

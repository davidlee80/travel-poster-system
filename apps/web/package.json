{
  "name": "@tps/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/copy-fonts.mjs && next build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "dev": "node scripts/copy-fonts.mjs && next dev -p 3000",
    "start": "next start -p 3000",
    "clean": "rimraf .next dist .turbo *.tsbuildinfo",
    "fonts:copy": "node scripts/copy-fonts.mjs"
  },
  "dependencies": {
    "@tps/schemas": "workspace:*",
    "next": "^15.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@tps/presentation": "workspace:*",
    "@tps/icon-library": "workspace:*",
    "@tps/shared": "workspace:*",
    "@tps/fonts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
